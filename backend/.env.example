# Chép tệp này thành backend/.env rồi chỉnh giá trị cho phù hợp máy của bạn.

# --- Chế độ chạy ---
# local: SQLite + Ollama cục bộ (mặc định khi làm đồ án)
# server: chuẩn bị cho triển khai thật (PostgreSQL + dịch vụ AI)
APP_MODE=local
LLM_PROVIDER=ollama

# --- Cơ sở dữ liệu ---
# Đường dẫn tương đối được hiểu là tính từ thư mục backend/app
DATABASE_PATH=learning_assistant.db
DB_TIMEOUT_SECONDS=10
DB_BUSY_TIMEOUT_MS=5000

# --- Dịch vụ AI cục bộ (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
MODEL_KEEP_ALIVE=10m
MODEL_TEMPERATURE=0.25
MODEL_TOP_P=0.9
MODEL_NUM_PREDICT=600
# Ollama mặc định dùng cửa sổ ngữ cảnh rất nhỏ, phải chỉ định tường minh
MODEL_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=180
HEALTH_TIMEOUT_SECONDS=2

# --- Bảo mật ---
SESSION_DAYS=7
PBKDF2_ITERATIONS=310000
DEFAULT_ADMIN_EMAIL=admin@mindora.local
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_MAX_UPLOAD_MB=20

# --- Vector nhúng và tìm kiếm ngữ nghĩa (RAG) ---
EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text = 768 chiều. Đổi sang bge-m3 thì đặt EMBEDDING_DIM=1024 và sinh lại vector cũ.
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16
RAG_TOP_K=6
# Ngưỡng tương đồng: thấp hơn ngưỡng này thì trả lời "chưa đủ thông tin" thay vì đoán bừa
RAG_MIN_SCORE=0.35
RAG_CONTEXT_CHARS=6000

# --- Giao diện web ---
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Nhật ký và lưu trữ ---
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=backend/logs
STORAGE_DIR=backend/app/storage

# --- Cổng chạy dịch vụ (dùng bởi start-local.ps1) ---
API_PORT=8000
